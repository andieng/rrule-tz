{
  "name": "rrule-tz",
  "version": "0.1.1",
  "description": "Timezone-safe wrapper around rrule — true-UTC occurrence queries, independent of the host machine's timezone.",
  "license": "MIT",
  "author": "Thuy Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andieng/rrule-tz.git"
  },
  "bugs": {
    "url": "https://github.com/andieng/rrule-tz/issues"
  },
  "homepage": "https://github.com/andieng/rrule-tz#readme",
  "keywords": [
    "rrule",
    "recurrence",
    "recurring-events",
    "icalendar",
    "rfc5545",
    "timezone",
    "dst",
    "scheduling",
    "calendar",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "rrule": "^2.8.1",
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
